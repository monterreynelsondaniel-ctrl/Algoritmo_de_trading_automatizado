# Environment: testnet or live
BINANCE_ENV=testnet
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_API_SECRET=

# Safety switches: defaults prevent real mutations
TRADING_ENABLED=false
DRY_RUN=true

SYMBOL=BTCUSDT
TIMEFRAME=4h
LEVERAGE=1
RISK_PER_TRADE_PCT=0.5
MAX_NOTIONAL_USDT=100.0
ATR_MULTIPLIER=1.5
BREAKEVEN_R_MULTIPLE=1.5
DRY_RUN_EQUITY_USDT=1000.0
INTEGRATION_TEST_NOTIONAL_USDT=10.0
INTEGRATION_TEST_HARD_CAP_USDT=150.0
RUN_BINANCE_INTEGRATION=0
LOG_LEVEL=INFO

# Strategy 2 AI reviewer. Replay is offline/fail-closed and needs cached decisions.
AI_DECISION_MODE=replay
AI_PROVIDER=openai
OPENAI_API_KEY=
# Research default. Change to gpt-5.6-sol or gpt-5.6-luna for comparisons.
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low
AI_CACHE_PATH=database/ai_decisions.db
AI_MAX_ATTEMPTS=2
OPENAI_TIMEOUT_SECONDS=30
# Independent local safeguards for each research run. Defaults reflect Terra pricing
# as of 2026-09-09; verify official pricing before every live experiment.
AI_MAX_RUN_COST_USD=2.5
AI_MAX_LIVE_CALLS_PER_RUN=100
# Includes visible structured output plus reasoning tokens.
AI_MAX_OUTPUT_TOKENS_PER_CALL=2000
AI_INPUT_COST_PER_MILLION_USD=2.0
AI_OUTPUT_COST_PER_MILLION_USD=12.0
